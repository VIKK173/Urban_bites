// Urban Bites — Prisma schema (MongoDB)
// NOTE: monetary values are stored as integer paise (₹1.00 = 100) and
// enum-like fields are Strings validated in application code. This
// eliminates floating point rounding errors in price calculations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================== USERS ==============================

model User {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses  Address[]
  orders     Order[]
  reviews    Review[]
  favorites  Favorite[]
  cartItems  CartItem[]
  coupons    Coupon[]   @relation("CouponCreator")
}

model Address {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String   @default("Home")
  fullText  String
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================== CATALOG ==============================

model Category {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  products Product[]

}

model Product {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  slug         String   @unique
  description  String
  price        Int // paise
  comparePrice Int? // paise — original price when discounted
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  image        String?
  isVeg        Boolean  @default(true)
  spiceLevel   Int      @default(0) // 0-3
  ingredients  String   @default("[]") // JSON string array
  allergens    String   @default("[]") // JSON string array
  options      String   @default("[]") // JSON customization groups [{name,required,choices:[{label,price}]}]
  rating       Float    @default(0)
  ratingCount  Int      @default(0)
  isAvailable  Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  soldCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]

}

model ProductImage {
  id        String  @id @default(cuid()) @map("_id")
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

// ============================== CART ==============================

model CartItem {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(1)
  options     String   @default("[]") // JSON [{label,price}]
  optionsHash String   @default("") // hash for grouping identical customizations
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, optionsHash])
}

// ============================== ORDERS ==============================

model Order {
  id            String    @id @default(cuid()) @map("_id")
  orderNumber   String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  status        String    @default("PLACED") // PLACED|CONFIRMED|PREPARING|READY|OUT_FOR_DELIVERY|DELIVERED|CANCELLED
  paymentStatus String    @default("PENDING") // PENDING|PAID|FAILED|REFUNDED|COD_PENDING
  paymentMethod String    @default("RAZORPAY") // RAZORPAY|COD
  subtotal      Int // paise
  discount      Int       @default(0)
  deliveryFee   Int       @default(0)
  tax           Int       @default(0)
  total         Int // paise
  couponCode    String?
  address       String    // JSON address snapshot
  contactName   String
  contactPhone  String
  instructions  String?
  etaMinutes    Int       @default(35)
  cancelReason  String?
  placedAt      DateTime  @default(now())
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    OrderItem[]
  payments Payment[]

}

model OrderItem {
  id        String   @id @default(cuid()) @map("_id")
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  // snapshots keep historical orders accurate after menu changes
  name      String
  image     String?
  unitPrice Int // paise
  quantity  Int
  options   String   @default("[]") // JSON
  lineTotal Int // paise

}

model Payment {
  id                String   @id @default(cuid()) @map("_id")
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  provider          String   @default("RAZORPAY") // RAZORPAY | RAZORPAY_DEV
  providerOrderId   String?
  providerPaymentId String?
  signature         String?
  amount            Int // paise
  currency          String   @default("INR")
  status            String   @default("CREATED") // CREATED|PAID|FAILED|REFUNDED
  method            String?
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

}

// ============================== MARKETING / ENGAGEMENT ==============================

model Coupon {
  id            String    @id @default(cuid()) @map("_id")
  code          String    @unique
  description   String?
  type          String // PERCENT | FLAT
  value         Int // percent (1-100) or paise
  minOrderValue Int       @default(0) // paise
  maxDiscount   Int? // paise cap for PERCENT
  isActive      Boolean   @default(true)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  createdById   String?
  createdBy     User?     @relation("CouponCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

}

model Review {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  orderId    String?
  rating     Int
  title      String?
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
}

model Favorite {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

}

// Singleton settings row (id = "main")
model RestaurantSettings {
  id                    String   @id @default("main") @map("_id")
  deliveryFee           Int      @default(3900) // paise ₹39
  freeDeliveryThreshold Int      @default(59900) // paise ₹599
  taxPercent            Float    @default(5) // GST %
  codEnabled            Boolean  @default(true)
  etaMinutes            Int      @default(35)
  offerTitle            String   @default("FLAT 20% OFF")
  offerText             String   @default("Use code URBAN20 on your first order and get flat 20% off up to ₹150.")
  offerCode             String   @default("URBAN20")
  offerDiscount         Int      @default(20)
  offerActive           Boolean  @default(true)
  address               String   @default("Shop 12, Food Street, Bandra West, Mumbai 400050")
  phone                 String   @default("+91 98765 43210")
  email                 String   @default("hello@urbanbites.example")
  openHours             String   @default("Mon–Sun · 11:00 AM – 11:30 PM")
  mapLat                Float    @default(19.0596)
  mapLng                Float    @default(72.8295)
  updatedAt             DateTime @updatedAt
}
